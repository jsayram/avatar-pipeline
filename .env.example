# Copy to .env and fill in real values. .env is gitignored — never commit it.
# worker.py loads this automatically (see scripts/worker.py); a real
# `export`ed environment variable always takes precedence over this file.

# Required only if config.yaml has wavespeed.enabled: true
WAVESPEED_API_KEY=

# Required only if config.yaml has telegram.enabled: true (the FR-4 approval
# loop). Create a bot via @BotFather in Telegram — no business verification
# needed, unlike WhatsApp Business API.
TELEGRAM_BOT_TOKEN=

# ---- Machine-specific settings (used by ops/install_launchd.sh and the dashboard) ----

# Prefix for the launchd labels; services are <prefix>.n8n, .gate, .comfyui, .dashboard.
# The dashboard's service-health panel reads the same value.
LAUNCHD_LABEL_PREFIX=com.example.avatar

# Absolute path to your ComfyUI checkout (only needed to install the comfyui service).
COMFYUI_DIR=

# Directory holding the node and n8n binaries, e.g. from nvm (only for the n8n service).
NODE_BIN_DIR=

# Public base URL n8n registers webhooks with: your Tailscale Funnel host, with a
# trailing slash (only for the n8n service; see docs/TAILSCALE-SETUP.md).
N8N_WEBHOOK_URL=https://your-machine.your-tailnet.ts.net/

# Optional. Defaults to $(brew --prefix)/bin; put it on launchd's PATH so ffmpeg/yt-dlp/exiftool resolve.
# HOMEBREW_BIN=
