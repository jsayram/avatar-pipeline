<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>AVATAR_PIPELINE_DIR</key>
		<string>__PROJECT_ROOT__</string>
		<key>N8N_LISTEN_ADDRESS</key>
		<string>127.0.0.1</string>
		<key>N8N_SECURE_COOKIE</key>
		<string>false</string>
		<key>NODES_EXCLUDE</key>
		<string>["n8n-nodes-base.localFileTrigger"]</string>
		<!-- WEBHOOK_URL: the PUBLIC base URL n8n uses when it registers webhooks
		     (e.g. the Telegram Trigger's setWebhook call). Must equal the
		     Tailscale Funnel hostname, WITH a trailing slash. n8n keeps
		     listening on localhost:5678; Funnel proxies public 443 -> 5678.
		     Set N8N_WEBHOOK_URL in .env to your real ts.net host (get it from
		     `tailscale funnel status` after enabling Funnel), then re-run
		     ops/install_launchd.sh. See docs/TAILSCALE-SETUP.md.
		     AVATAR_PIPELINE_DIR is read by the Execute Command nodes in
		     n8n/workflow*.json. -->
		<key>WEBHOOK_URL</key>
		<string>__N8N_WEBHOOK_URL__</string>
		<key>PATH</key>
		<string>__NODE_BIN_DIR__:__HOMEBREW_BIN__:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>__LABEL_PREFIX__.n8n</string>
	<key>ProgramArguments</key>
	<array>
		<string>__NODE_BIN_DIR__/node</string>
		<string>__NODE_BIN_DIR__/n8n</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>__LOG_DIR__/avatar-n8n.log</string>
	<key>StandardOutPath</key>
	<string>__LOG_DIR__/avatar-n8n.log</string>
	<key>WorkingDirectory</key>
	<string>__HOME__</string>
</dict>
</plist>
