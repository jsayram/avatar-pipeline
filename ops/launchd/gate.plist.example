<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>__LABEL_PREFIX__.gate</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PROJECT_ROOT__/venv/bin/python</string>
    <string>__PROJECT_ROOT__/scripts/face_gate.py</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__PROJECT_ROOT__</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__LOG_DIR__/avatar-gate.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/avatar-gate.log</string>
</dict>
</plist>
